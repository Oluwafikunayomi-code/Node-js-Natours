header.header
  button.mobile-nav-backdrop(
    type='button'
    aria-label='Close navigation'
  )
  .header__mobile-menu
    nav.nav.nav--tours
      a.nav__el(href='/') All tours

    nav.nav.nav--user
      if user
        a.nav__el.nav__el--logout Log out
        a.nav__el(href='/me')
          img.nav__user-img(src=user.photo.startsWith('http') ? user.photo : `/img/users/${user.photo}` alt=`Photo of ${user.name}`)
          span= user.name.split(' ')[0]
      else
        a.nav__el(href='/login') Log in
        a.nav__el.nav__el--cta(href='/signup') Sign up

  .header__logo
    img(src='/img/logo-white.png' alt='Natours logo')

  button.mobile-nav-toggle(
    type='button'
    aria-label='Open navigation'
    aria-expanded='false'
  )
    span
    span
    span