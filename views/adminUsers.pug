extends base

block content
  main.main
    .user-view.admin-dashboard
      nav.user-view__menu
        h5.admin-dashboard__sidebar-title Admin Panel
        ul.side-nav
          li
            a(href='/admin') Dashboard
          li
            a(href='/admin/tours') Manage Tours
          li.side-nav--active
            a(href='/admin/users') Manage Users
          li
            a(href='/admin/bookings') Manage Bookings
          li
            a(href='/admin/reviews') Manage Reviews

      .user-view__content.admin-dashboard__content
        .admin-dashboard__header
          h2.heading-secondary Manage Users
          p.admin-dashboard__welcome View all registered users.

        .admin-users
          if users.length
            each user in users
              .admin-user
                .admin-user__info
                  img.admin-user__photo(src=user.photo ? (user.photo.startsWith('http') ? user.photo : `/img/users/${user.photo}`) : '/img/users/default.jpg' alt=user.name)
                  .admin-user__details
                    h3= user.name
                    p= user.email
                    p Role: #{user.role}
                    p Status: #{user.active ? 'Active' : 'Inactive'}
          else
            p No users found.