{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch --target bundle",
    "build:js": "parcel build --target bundle"
  },
  "bundle": "public/js/bundle.js",
  "targets": {
    "bundle": {
      "source": "public/js/index.js",
      "context": "browser",
      "distDir": "./public/js",
      "outputFormat": "global",
      "isLibrary": false,
      "includeNodeModules": true
    }
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  },
  "author": "Jonas Schmedtmann",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.4.4",
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^7.0.0",
    "express": "^4.16.4",
    "express-mongo-sanitize": "^1.3.2",
    "express-rate-limit": "^3.5.0",
    "helmet": "^3.16.0",
    "hpp": "^0.2.2",
    "html-to-text": "^5.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "morgan": "^1.9.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pug": "^3.0.4",
    "sharp": "^0.35.5",
    "slugify": "^1.3.4",
    "stripe": "^7.0.0",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "deasync": "^0.1.32",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "nodemon": "^3.1.14",
    "parcel": "^2.16.4",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": "22.x"
  }
}
